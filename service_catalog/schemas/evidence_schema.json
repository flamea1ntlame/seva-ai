{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Government Evidence Source Schema",
  "type": "object",
  "properties": {
    "evidence_id": { "type": "string", "description": "Unique identifier for this piece of evidence, e.g., EV-KA-INC-001" },
    "source_url": { "type": ["string", "null"] },
    "source_title": { "type": ["string", "null"] },
    "source_type": { "type": ["string", "null"], "enum": ["GOVERNMENT_PORTAL", "ACT", "RULE", "GOVERNMENT_ORDER", "NOTIFICATION", "CIRCULAR", "SECONDARY", null] },
    "date_accessed": { "type": "string", "format": "date", "description": "ISO 8601 date format" },
    "jurisdiction": { "type": ["string", "null"] },
    "service": { "type": ["string", "null"] },
    "issuing_authority": { "type": ["string", "null"] },
    "exact_supported_claim": { "type": ["string", "null"] },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of evidence_ids this source explicitly conflicts with"
    }
  },
  "required": [
    "evidence_id", "source_url", "source_title", "source_type", 
    "date_accessed", "jurisdiction", "service", "issuing_authority", "exact_supported_claim"
  ]
}
